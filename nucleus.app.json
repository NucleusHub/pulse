{
  "id": "pulse",
  "name": "Pulse",
  "description": "Widget & dashboard management",
  "version": "0.3.0",
  "manifestVersion": 1,
  "compatibility": {
    "nucleus": ">=0.1.0 <1.0.0"
  },
  "icon": "icon.svg",
  "hub": {
    "showInSidebar": false,
    "showOnDashboard": false
  },
  "nginx": {
    "routes": [
      {
        "path": "/api/pulse",
        "upstream": "pulse-server:3004"
      }
    ]
  },
  "server": {
    "service": "pulse-server",
    "port": 3004,
    "env": {
      "MONGODB_URI": "mongodb://mongo:27017/nucleus",
      "JWT_SECRET": "${JWT_SECRET:-nucleus-jwt-secret}"
    },
    "depends": [
      "mongo"
    ],
    "bindMounts": [
      "../core:/app/core:ro"
    ],
    "healthEndpoint": "/health"
  }
}
